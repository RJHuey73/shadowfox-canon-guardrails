{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 hooks/pre_tool_guard.py" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 hooks/pre_tool_guard.py" }
        ]
      },
      {
        "matcher": "mcp__.*(airtable|Airtable|AIRTABLE|supabase|Supabase|SUPABASE|notion|Notion|NOTION|github|GitHub|Github|GITHUB|sfx-).*",
        "hooks": [
          { "type": "command", "command": "python3 hooks/pre_tool_guard.py" }
        ]
      }
    ]
  }
}
