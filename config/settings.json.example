{
  "_comment": "EXAMPLE ONLY - not installed by this repo. Replace /ABSOLUTE/PATH/TO/shadowfox-canon-guardrails with the real absolute path before use. The path must be absolute: with a relative path the hook runs only when the working directory happens to be this repo (otherwise the interpreter fails with exit 2). The matchers route every Bash call, every file-write tool and EVERY MCP tool through the hook so that unclassified MCP operations are denied by policy; do not narrow 'mcp__.*' to a list of names.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"/ABSOLUTE/PATH/TO/shadowfox-canon-guardrails/hooks/pre_tool_guard.py\"" }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 \"/ABSOLUTE/PATH/TO/shadowfox-canon-guardrails/hooks/pre_tool_guard.py\"" }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"/ABSOLUTE/PATH/TO/shadowfox-canon-guardrails/hooks/pre_tool_guard.py\"" }
        ]
      }
    ]
  }
}
