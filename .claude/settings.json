{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr review * --approve *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo rename *)",
      "Bash(gh repo archive *)",
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)",
      "Bash(gh release upload *)",
      "Bash(gh secret set *)",
      "Bash(gh secret delete *)",
      "Bash(gh variable set *)",
      "Bash(gh variable delete *)",
      "Bash(gh api *pulls/*/merge *)",
      "Bash(gh api *ccr/auto_merge *)",
      "Bash(git push * main *)",
      "Bash(git push * master *)",
      "Bash(git push *:main *)",
      "Bash(git push *:master *)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push *:refs/heads/master *)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push --mirror *)",
      "Bash(git push * --mirror *)",
      "Bash(git push --all *)",
      "Bash(git push * --all *)",
      "mcp__github__merge_pull_request",
      "mcp__github__delete_file",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(**/.claude/hooks/**)",
      "Edit(//etc/claude-code/**)"
    ],
    "ask": [
      "Bash(gh pr ready *)",
      "Bash(gh pr reopen *)",
      "Bash(gh issue reopen *)",
      "Bash(gh repo create *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh api *ccr/ready_for_review *)",
      "Bash(gh api *actions/workflows/*/dispatches *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --tags *)",
      "Bash(git push * --tags *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/github_transition_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/github_transition_guard.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
